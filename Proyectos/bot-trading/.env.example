# Copia este archivo a .env y rellénalo. NUNCA lo subas a git.
# Claves del exchange: créalas SIN permiso de retirada y, si se puede, restringidas por IP.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# EXCHANGE_API_PASSWORD=   # solo algunos exchanges (OKX, KuCoin...)

# Confirmación explícita para operar con dinero real (mode: live).
# BOT_CONFIRM_LIVE=yes

# Alertas por Telegram (opcional): crea un bot con @BotFather y obtén tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dead man's switch (opcional), p. ej. https://hc-ping.com/<uuid> de healthchecks.io
HEARTBEAT_URL=
